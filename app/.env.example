# LLM (Groq or vLLM)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
SMALL_MODEL_NAME=llama-3.1-8b-versatile
LARGE_MODEL_NAME=llama-3.3-70b-instant

# Langfuse (optional)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=analytics_docs

# BigQuery — set project + credentials for live data; mock mode used when unset
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=analytics
BIGQUERY_CREDENTIALS_PATH=
BIGQUERY_SCHEMA_FILE=data/bigquery_schema.json
BIGQUERY_MAX_ROWS=100
BIGQUERY_MOCK_MODE=true
